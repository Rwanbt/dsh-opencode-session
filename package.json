{
  "name": "dsh-opencode-session",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin: sends the per-conversation x-opencode-session header that OpenCode Go requires on every route, including hand-declared ones.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "opencode",
    "opencode-go"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "config",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --check index.js && node --test"
  }
}
